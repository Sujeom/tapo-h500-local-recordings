{
  "title": "Tapo H500 Local Recordings",
  "config": {
    "step": {
      "user": {
        "title": "Connect to a Tapo H500",
        "description": "All traffic remains local. The TP-Link cloud password is required only for local media encryption.",
        "data": {
          "host": "H500 IP address",
          "username": "Camera account username",
          "password": "Camera account password",
          "cloud_password": "TP-Link cloud account password"
        }
      },
      "reconfigure": {
        "title": "Change your Tapo H500's address",
        "description": "Point this hub at a new address without setting it up again -- everything on the entry stays, including your face names, your retention settings and the entity ids your automations and cards refer to. Leave the passwords blank to keep the stored ones.",
        "data": {
          "host": "Hub IP address or hostname",
          "username": "Camera account username",
          "password": "Camera account password",
          "cloud_password": "TP-Link cloud account password"
        }
      },
      "reauth_confirm": {
        "title": "Reconnect to your Tapo H500",
        "description": "The hub refused the stored credentials outright rather than simply failing to answer. Retype the camera account -- the local account made in the Tapo app, not the TP-Link email used to sign in to it. All traffic remains local; the TP-Link cloud password is still used only for local media encryption.",
        "data": {
          "username": "Camera account username",
          "password": "Camera account password",
          "cloud_password": "TP-Link cloud account password"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect or authenticate with the H500.",
      "no_cameras": "The H500 reported no paired cameras.",
      "invalid_auth": "The H500 rejected these credentials."
    },
    "abort": {
      "reauth_successful": "Reconnected. The stored credentials have been replaced.",
      "reconfigure_successful": "Updated. This entry now talks to the hub at its new address.",
      "already_configured": "Another entry is already set up at that address. Two entries on one hub means two pollers, each logging in to a device that stops responding under repeated authentication."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Tapo H500 options",
        "data": {
          "poll_interval": "Seconds between activity checks",
          "auto_download": "Download new recordings automatically",
          "convert_mp4": "Convert downloads to MP4",
          "keep_downloads": "Downloaded clips to keep per camera"
        },
        "data_description": {
          "convert_mp4": "MP4 plays in the browser; turn this off to keep the hub's original MPEG-TS.",
          "keep_downloads": "0 keeps everything. Any other number prunes the oldest automatic downloads once a camera holds more than that. Manual downloads are never pruned."
        }
      }
    }
  },
